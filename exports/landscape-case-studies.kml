gle.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="private-gardens"><IconStyle><color>ffb07ad6</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="flood-suds"><IconStyle><color>ffc9a626</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="forestry"><IconStyle><color>ff3b7a2a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="recreation"><IconStyle><color>ff1e8ae0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hotels-resorts"><IconStyle><color>ffd87f1e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="industrial-commercial"><IconStyle><color>ff4a5a8c</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="historic"><IconStyle><color>ff6e6e6e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="land-art"><IconStyle><color>ff2d52a0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="interior-planting"><IconStyle><color>ff6bae7f</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="monuments"><IconStyle><color>ff6b4b4b</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="derelict-land"><IconStyle><color>ff3a6b9a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hospital-gardens"><IconStyle><color>ff7a5ce0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="transport-corridors"><IconStyle><color>ffa85f3a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="masterplanning"><IconStyle><color>ffa34f7a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Placemark><name>Benjakitti Forest Park</name><description>เปลี่ยนพื้นที่โรงงานยาสูบเดิมกลางกรุงเทพฯ ให้เป็นสวนป่าพื้นที่ชุ่มน้ำแบบ 'เมืองฟองน้ำ' ที่รับน้ำฝนในฤดูมรสุม บำบัดน้ำคลอง และฟื้นป่าพื้นถิ่นด้วยงบประมาณจำกัด

ผู้ออกแบบ: Arsomsilp Community and Environmental Architect + Turenscape
ปี: 2022  |  พื้นที่: 414,400 sq. m. (259 ไร่) — ส่วนขยายสวนป่า; สวนเบญจกิติทั้งหมดราว 0.72 sq. km. (450 ไร่)
หมวด: สวนสาธารณะ, ป้องกันน้ำท่วมและระบบระบายน้ำยั่งยืน (SuDS), ฟื้นฟูพื้นที่รกร้าง, ออกแบบพื้นที่ป่าไม้ (Public parks, Flood protection and SUDS, Derelict land reclamation, Forestry design)
งานวิจัย: Modular Approach Creating Low-Maintenance Sponge City: Benjakitti Forest Park in Bangkok, Thailand (2023) https://doi.org/10.15302/j-laf-0-040003
งานวิจัย: Inequality in Active Public Park: A Case Study of Benjakitti Park in Bangkok, Thailand (2017) https://doi.org/10.1016/j.proeng.2017.07.083
