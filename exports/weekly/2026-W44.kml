le.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="private-gardens"><IconStyle><color>ffb07ad6</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="flood-suds"><IconStyle><color>ffc9a626</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="forestry"><IconStyle><color>ff3b7a2a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="recreation"><IconStyle><color>ff1e8ae0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hotels-resorts"><IconStyle><color>ffd87f1e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="industrial-commercial"><IconStyle><color>ff4a5a8c</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="historic"><IconStyle><color>ff6e6e6e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="land-art"><IconStyle><color>ff2d52a0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="interior-planting"><IconStyle><color>ff6bae7f</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="monuments"><IconStyle><color>ff6b4b4b</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="derelict-land"><IconStyle><color>ff3a6b9a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hospital-gardens"><IconStyle><color>ff7a5ce0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="transport-corridors"><IconStyle><color>ffa85f3a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="masterplanning"><IconStyle><color>ffa34f7a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Placemark><name>Parco della Reggia di Rivalta</name><description>การเปลี่ยนพื้นที่สวนราชสำนักตระกูลเอสเตแห่งศตวรรษที่ 18 ที่ถูกทิ้งร้างและกลายเป็นนาเกษตร ให้เป็นสวนสาธารณะ 25 เฮกตาร์ของเมืองเรจโจเอมีเลีย โดยไม่สร้างสวนบาโรกขึ้นใหม่ แต่ซ้อนชั้นประวัติศาสตร์ ทุ่งหญ้าเกษตร และการใช้งานร่วมสมัยไว้ด้วยกันแบบ 'ปาลิมเซสต์' เปิดใช้เดือนมิถุนายน 2025

ผู้ออกแบบ: Openfabric (ผู้ออกแบบหลัก) ร่วมกับ Caarpa และ F&amp;M Ingegneria; ที่ปรึกษา Giuseppe Baldi และ Paolo Tegoni Studio
ปี: 2025  |  พื้นที่: 250,000 sq. m. (156 ไร่) — พื้นที่ดาดแข็ง 5.33 เฮกตาร์ พื้นที่สีเขียว 17.21 เฮกตาร์
หมวด: สวนสาธารณะ, อนุรักษ์และฟื้นฟูพื้นที่ประวัติศาสตร์, ออกแบบพื้นที่นันทนาการ (Public parks, Historic preservation and restoration, Recreation design)
แหล่งข้อมูล: https://landezine-award.com/parco-reggia-di-rivalta-reggio-emilia/
แหล่งข้อมูล: https://www.openfabric.eu/projects/parco-reggia-di-rivalta/
