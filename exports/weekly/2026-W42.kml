le.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="private-gardens"><IconStyle><color>ffb07ad6</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="flood-suds"><IconStyle><color>ffc9a626</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="forestry"><IconStyle><color>ff3b7a2a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="recreation"><IconStyle><color>ff1e8ae0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hotels-resorts"><IconStyle><color>ffd87f1e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="industrial-commercial"><IconStyle><color>ff4a5a8c</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="historic"><IconStyle><color>ff6e6e6e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="land-art"><IconStyle><color>ff2d52a0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="interior-planting"><IconStyle><color>ff6bae7f</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="monuments"><IconStyle><color>ff6b4b4b</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="derelict-land"><IconStyle><color>ff3a6b9a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hospital-gardens"><IconStyle><color>ff7a5ce0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="transport-corridors"><IconStyle><color>ffa85f3a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="masterplanning"><IconStyle><color>ffa34f7a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Placemark><name>Chao Phraya Sky Park</name><description>เปลี่ยนโครงสร้างรถไฟฟ้าลาวาลินที่ถูกทิ้งร้างเกือบ 40 ปีข้างสะพานพระปกเกล้า ให้เป็นสวนลอยฟ้าข้ามแม่น้ำเจ้าพระยาแห่งแรกของไทย ยาว 280 ม. เชื่อมย่านเมืองเก่าฝั่งพระนครกับฝั่งธนบุรี

ผู้ออกแบบ: LANDPROCESS (Kotchakorn Voraakhom) ร่วมกับ UDDC จุฬาลงกรณ์มหาวิทยาลัย และ N7A Architects
ปี: 2020  |  พื้นที่: 2,380 sq. m. (1.5 ไร่) — สะพานยาว 280 ม. กว้าง 8.5 ม.
หมวด: แนวเส้นทางคมนาคม, ทางสีเขียว, ทางจักรยาน (Transport corridors, Greenways, Cycleways)
แหล่งข้อมูล: https://www.landprocess.co.th/chao-phraya-sky-park
