le.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="private-gardens"><IconStyle><color>ffb07ad6</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="flood-suds"><IconStyle><color>ffc9a626</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="forestry"><IconStyle><color>ff3b7a2a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="recreation"><IconStyle><color>ff1e8ae0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hotels-resorts"><IconStyle><color>ffd87f1e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="industrial-commercial"><IconStyle><color>ff4a5a8c</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="historic"><IconStyle><color>ff6e6e6e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="land-art"><IconStyle><color>ff2d52a0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="interior-planting"><IconStyle><color>ff6bae7f</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="monuments"><IconStyle><color>ff6b4b4b</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="derelict-land"><IconStyle><color>ff3a6b9a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hospital-gardens"><IconStyle><color>ff7a5ce0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="transport-corridors"><IconStyle><color>ffa85f3a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="masterplanning"><IconStyle><color>ffa34f7a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Placemark><name>Someș River Regeneration</name><description>โครงการฟื้นฟูตลิ่งแม่น้ำ Someș ตลอดราว 15 กม. ที่ไหลผ่านเมืองคลูจ-นาโปกา โรมาเนีย จากการประกวดแบบนานาชาติปี 2017 เปลี่ยนตลิ่งคอนกรีตเป็นระเบียงธรรมชาติ หาด อัฒจันทร์ และโครงข่ายทางเดิน–ทางจักรยานต่อเนื่องที่เชื่อมสวนต่าง ๆ ของเมือง

ผู้ออกแบบ: PRÁCTICA (Jaime Daroca, José Mayoral, José Ramón Sierra) — ภูมิสถาปัตยกรรม Landlab; สถาปนิกท้องถิ่น Planwerk
ปี: 2023  |  พื้นที่: 113,000 sq. m. (70.6 ไร่) — พื้นที่สีเขียวหลังโครงการ 11.3 เฮกตาร์ตามแนวแม่น้ำราว 15 กม.
หมวด: ทางสีเขียว, ป้องกันน้ำท่วมและระบบระบายน้ำยั่งยืน (SuDS), ทางจักรยาน, ฟื้นฟูพื้นที่รกร้าง (Greenways, Flood protection and SUDS, Cycleways, Derelict land reclamation)
งานวิจัย: Río Somes. Cluj-Napoca, Rumania, 2023 (2023) https://doi.org/10.4067/s0717-69962023000200062
แหล่งข้อมูล: https://www.archdaily.com/1027331/somes-river-park-regeneration-practica
แหล่งข้อมูล: https://landezine-award.com/?p=63902
แหล่งข้อมูล: https://prizes.new-european-bauhaus.europa.eu/node/367093</description><styleUrl>#greenways</styleUrl><ExtendedData><Data name="gx_media_links"><value>https://images.adsttc.com/media/images/67bc/e4ac/3847/8a01/89cd/29ee/large_jpg/1718-pl-masterplan-lr-6.jpg https://images.adsttc.com/media/images/67bc/e4b2/3847/8a01/89cd/29f1/large_jpg/1718-pl-zona-1-lr-9.jpg https://images.adsttc.com/media/images/67bc/e49f/8121/fa01/89ca/7ae0/large_jpg/rio-somes-practica_12.jpg https://images.adsttc.com/media/images/67bc/e4b1/8121/fa01/89ca/7aea/large_jpg/rio-somes-practica_10.jpg https://images.adsttc.com/media/images/67bc/e4a9/3847/8a01/89cd/29ec/large_jpg/rio-somes-practica_11.jpg https://images.adsttc.com/media/images/67bc/e4a7/8121/fa01/89ca/7ae2/large_jpg/rio-somes-practica_7.jpg https://images.adsttc.com/media/images/67bc/e4a5/8121/fa01/89ca/7ae1/large_jpg/rio-somes-practica_9.jpg https://images.adsttc.com/media/images/67bc/e49f/3847/8a01/89cd/29ea/large_jpg/rio-somes-practica_8.jpg https://images.adsttc.com/media/images/67bc/e4ae/3847/8a01/89cd/29ef/large_jpg/rio-somes-practica_4.jpg https://images.adsttc.com/media/images/67bc/e4bb/8121/fa01/89ca/7aec/large_jpg/rio-somes-practica_5.jpg https://images.adsttc.com/media/images/67bc/e4ae/8121/fa01/89ca/7ae6/large_jpg/rio-somes-practica_6.jpg https://images.adsttc.com/media/images/67bc/e49d/8121/fa01/89ca/7adf/large_jpg/rio-somes-practica_3.jpg https://images.adsttc.com/media/images/67bc/e49d/3847/8a01/89cd/29e9/large_jpg/rio-somes-practica_2.jpg https://images.adsttc.com/media/images/67bc/e49b/3847/8a01/89cd/29e8/large_jpg/rio-somes-practica_1.jpg https://images.adsttc.com/media/images/67bc/e4aa/8121/fa01/89ca/7ae4/large_jpg/1718-axo-several-2.jpg https://images.adsttc.com/media/images/67bc/e4ab/8121/fa01/89ca/7ae5/large_jpg/1718-dia-02-4.jpg</value></Data><Data name="designer"><value>PRÁCTICA (Jaime Daroca, José Mayoral, José Ramón Sierra) — ภูมิสถาปัตยกรรม Landlab; สถาปนิกท้องถิ่น Planwerk</value></Data><Data name="year"><value>2023</value></Data><Data name="category"><value>Greenways</value></Data><Data name="all_categories"><value>Greenways, Flood protection and SUDS, Cycleways, Derelict land reclamation</value></Data><Data name="added_week"><value>2026-W47</value></Data></ExtendedData><Point><coordinates>23.5779,46.771,0</coordinates></Point></Placemark><Placemark><name>Jewel Changi Airport — Shiseido Forest Valley &amp; Canopy Park</name><description>สวนในร่มขั้นบันไดสูงห้าชั้นใต้โดมกระจกรูปโดนัทของสนามบินชางงี ล้อมน้ำตกในร่ม Rain Vortex สูง 40 ม. ออกแบบโดย PWP Landscape Architecture ด้วยต้นไม้ราว 2,500 ต้นและไม้พุ่มราว 100,000 ต้น เป็นหัวใจที่ทำให้ศูนย์การค้าสนามบินกลายเป็น 'สวนสาธารณะในร่ม' ของเมือง

ผู้ออกแบบ: PWP Landscape Architecture (ภูมิสถาปัตยกรรม) ร่วมกับ ICN Design International — สถาปัตยกรรม Safdie Architects; สถาปนิกบริหารโครงการ RSP; น้ำตก WET Design
ปี: 2019  |  พื้นที่: 22,000 sq. m. (13.8 ไร่) — Forest Valley; Canopy Park ชั้นบนสุดอีกราว 14,000 ตร.ม.
หมวด: พืชพรรณในงานออกแบบภายใน, พื้นที่อุตสาหกรรมและพาณิชยกรรม, ออกแบบพื้นที่นันทนาการ, แนวเส้นทางคมนาคม (Horticultural design aspects of interior design, Industrial and commercial sites, Recreation design, Transport corridors)
งานวิจัย: Jewel Changi Singapore: The Airport is the Destination (2026) https://doi.org/10.3724/j.fjyl.la20260307
แหล่งข้อมูล: https://en.wikipedia.org/wiki/Jewel_Changi_Airport
แหล่งข้อมูล: https://www.archdaily.com/915688/jewel-changi-airport-safdie-architects
