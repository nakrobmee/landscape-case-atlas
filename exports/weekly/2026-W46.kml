le.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="private-gardens"><IconStyle><color>ffb07ad6</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="flood-suds"><IconStyle><color>ffc9a626</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="forestry"><IconStyle><color>ff3b7a2a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="recreation"><IconStyle><color>ff1e8ae0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hotels-resorts"><IconStyle><color>ffd87f1e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="industrial-commercial"><IconStyle><color>ff4a5a8c</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="historic"><IconStyle><color>ff6e6e6e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="land-art"><IconStyle><color>ff2d52a0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="interior-planting"><IconStyle><color>ff6bae7f</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="monuments"><IconStyle><color>ff6b4b4b</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="derelict-land"><IconStyle><color>ff3a6b9a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hospital-gardens"><IconStyle><color>ff7a5ce0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="transport-corridors"><IconStyle><color>ffa85f3a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="masterplanning"><IconStyle><color>ffa34f7a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Placemark><name>Rachel de Queiroz Park (Parque Rachel de Queiroz)</name><description>สวนสาธารณะเชิงเส้นในฟอร์ตาเลซาที่เปลี่ยนที่รกร้างซึ่งเคยเป็นที่ทิ้งขยะและท่อน้ำเสียลักลอบ ให้เป็นระบบพื้นที่ชุ่มน้ำ 9 บ่อเชื่อมกันที่ทั้งกรองน้ำลำธาร Cachoeirinha และหน่วงน้ำท่วม พร้อมพื้นที่กีฬาและนันทนาการสำหรับย่านที่ขาดแคลนพื้นที่สาธารณะ

ผู้ออกแบบ: Architectus S/S (Elton Timbó, Mariana Furlani, Alexandre Landim, Ricardo Sabóia, Gerson Amaral, Jaqueline Martinez)
ปี: 2022 (ระยะที่ 1)  |  พื้นที่: 90,969 sq. m. (56.9 ไร่) — พื้นที่ระยะที่ 1 ตามข้อมูลผู้ออกแบบ; แนวสวนทั้งหมดยาวราว 10 กม.
หมวด: ป้องกันน้ำท่วมและระบบระบายน้ำยั่งยืน (SuDS), สวนสาธารณะ, ฟื้นฟูพื้นที่รกร้าง, ออกแบบพื้นที่นันทนาการ (Flood protection and SUDS, Public parks, Derelict land reclamation, Recreation design)
งานวิจัย: Intervenções urbanas com Soluções Baseadas na Natureza e o Direito ao Lazer: Parque Linear Rachel de Queiroz em Fortaleza (2024) https://openalex.org/W7120697737
งานวิจัย: Potencial do Parque Rachel de Queiroz como infraestrutura verde para a drenagem da cidade de Fortaleza (CE) (2025) https://doi.org/10.36926/editorainovar-978-65-5388-313-0_008
