le.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="private-gardens"><IconStyle><color>ffb07ad6</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="flood-suds"><IconStyle><color>ffc9a626</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="forestry"><IconStyle><color>ff3b7a2a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="recreation"><IconStyle><color>ff1e8ae0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hotels-resorts"><IconStyle><color>ffd87f1e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="industrial-commercial"><IconStyle><color>ff4a5a8c</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="historic"><IconStyle><color>ff6e6e6e</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="land-art"><IconStyle><color>ff2d52a0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="interior-planting"><IconStyle><color>ff6bae7f</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="monuments"><IconStyle><color>ff6b4b4b</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="derelict-land"><IconStyle><color>ff3a6b9a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="hospital-gardens"><IconStyle><color>ff7a5ce0</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="transport-corridors"><IconStyle><color>ffa85f3a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="masterplanning"><IconStyle><color>ffa34f7a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Placemark><name>Lucas Museum of Narrative Art Park &amp; Gardens</name><description>สวนสาธารณะรอบพิพิธภัณฑ์ใน Exposition Park ที่เปลี่ยนลานจอดรถแอสฟัลต์เป็นภูมิทัศน์เล่าเรื่อง ออกแบบโดย Studio-MLA เปิดให้ทุกคนเข้าใช้ฟรีโดยไม่ต้องซื้อบัตรพิพิธภัณฑ์ เพิ่มพื้นที่สีเขียวให้เซาท์ลอสแอนเจลิส

ผู้ออกแบบ: Studio-MLA (Mia Lehrer) — ภูมิสถาปัตยกรรม; อาคารโดย MAD Architects (Ma Yansong) ร่วมกับ Stantec
ปี: 2026 (เปิดให้ประชาชนเข้าชม 22 กันยายน 2026)  |  พื้นที่: 52,600 sq. m. (33 ไร่) — ทั้งวิทยาเขตตามข้อมูลพิพิธภัณฑ์; Studio-MLA ระบุพื้นที่งานออกแบบราว 44,500 sq. m. (28 ไร่)
หมวด: สวนสาธารณะ, หลังคาเขียวและสวนบนหลังคา (Public parks, Living roofs and roof gardens)
แหล่งข้อมูล: https://lucasmuseum.org/press/lucas-museum-of-narrative-art-opens-to-the-public-on-september-22-2026
แหล่งข้อมูล: https://studio-mla.com/design/lucas-museum-of-narrative-art/
แหล่งข้อมูล: https://laist.com/news/arts-and-entertainment/lucas-museum-of-narrative-art-open</description><styleUrl>#public-parks</styleUrl><ExtendedData><Data name="gx_media_links"><value>https://studio-mla.com/wp-content/uploads/2021/03/lucas-nov-25-20-fixed-1920x1440.jpg https://lucasmuseum.org/media/8e8977bd-e04d-4388-a6f2-8393fa57e6d1/01-courtesy-lucas-museum-of-narrative-art-photo-by-huftoncrow.jpg https://studio-mla.com/wp-content/uploads/2021/03/lucas-nov-25-12b-fix-web.jpg https://studio-mla.com/wp-content/uploads/2021/03/lucas-nov-25-21-olive-web.jpg https://studio-mla.com/wp-content/uploads/2021/03/lucas-jan26-15-web2-olive-1920x1440.jpg https://lucasmuseum.org/media/54f2ed79-df29-4ee4-bef8-08b9b5db455b/18-courtesy-lucas-museum-of-narrative-art-photo-by-huftoncrow.jpg https://lucasmuseum.org/media/c7831774-6f33-4b71-9b81-622e2e110f61/lucas-nov-25-25.jpg https://static-2026.dezeen.com/uploads/2025/11/lucas-museum-mad-los-angeles_dezeen_2364-gero-1704x959.jpg https://static-2026.dezeen.com/uploads/2025/11/lucas-museum-mad-los-angeles_dezeen_2364_col_-1704x959.jpg https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/Lucas_Museum_of_Narrative_Art_%282026%29.jpg/1280px-Lucas_Museum_of_Narrative_Art_%282026%29.jpg</value></Data><Data name="designer"><value>Studio-MLA (Mia Lehrer) — ภูมิสถาปัตยกรรม; อาคารโดย MAD Architects (Ma Yansong) ร่วมกับ Stantec</value></Data><Data name="year"><value>2026 (เปิดให้ประชาชนเข้าชม 22 กันยายน 2026)</value></Data><Data name="category"><value>Public parks</value></Data><Data name="all_categories"><value>Public parks, Living roofs and roof gardens</value></Data><Data name="added_week"><value>2026-W45</value></Data></ExtendedData><Point><coordinates>-118.2907,34.0158,0</coordinates></Point></Placemark><Placemark><name>Pharmaceutics Square, Technopolis Moscow</name><description>จัตุรัสสวนในเขตเศรษฐกิจพิเศษ Technopolis Moscow ที่ขยายจานเพาะเชื้อเป็นผังสวนรูปวงกลม มีวงแหวนมัลติมีเดียกว้าง 30 เมตร บ่อน้ำ และแปลงปลูกเป็นพื้นที่พักของพนักงานโรงงานยาและคนในย่าน

ผู้ออกแบบ: 8 LINES ร่วมกับ АФА (Бюро АФА) — แนวคิด; 8 LINES — ดำเนินการก่อสร้าง; mos.ru ระบุสถาปนิก Anton Kochurkin เป็นผู้พัฒนาแนวคิด
ปี: 2026 (ออกแบบ ก.พ.–มิ.ย. ก่อสร้าง มิ.ย.–ก.ย.; เปิดรับวันเมืองมอสโก)  |  พื้นที่: -
หมวด: พื้นที่อุตสาหกรรมและพาณิชยกรรม, ลานเมือง (Industrial and commercial sites, Urban squares)
